# Till Inbox reads its settings from these variables. Placeholders only: never commit real values.
# On Vercel, set them in Project Settings > Environment Variables (mark the two secrets as Sensitive).
# Locally, `vercel env pull .env.local` brings them down along with the OIDC token Vercel Connect needs.

# Required
TILL_ADMIN_SLACK_IDS=U0123ABCD,U0456EFGH      # who approves payment links, at most 5 (Slack profile > Copy member ID)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx            # secret: Resend > API Keys, used to read received emails
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx  # secret: Resend > Webhooks > your webhook > Signing secret

# Optional (defaults shown)
# TILL_AIRWALLEX_ACCOUNT_ID=acct_xxxxxxxx     # needed when your Airwallex login can see more than one account
# TILL_COMPANY_NAME=our team                  # signs the reply
# TILL_SLACK_CONNECTOR=slack/till-inbox
# TILL_AIRWALLEX_CONNECTOR=airwallex/till-sandbox
# TILL_ALLOW_LIVE_AIRWALLEX=false             # true lets the connector point at a live Airwallex server
# TILL_LINK_EXPIRY_DAYS=7
# TILL_MAX_AMOUNT=10000
# TILL_MODEL=openai/gpt-5
# TILL_MODEL_REASONING_EFFORT=low
# TILL_INBOUND_PER_MINUTE=30
# TILL_INBOUND_PER_SENDER_PER_HOUR=5

# Sending the reply by email: OFF by default. When true, an admin gets a "Send reply" button.
# TILL_SEND_REPLY_EMAIL=false
# TILL_REPLY_FROM=orders@your-verified-domain.example   # required when TILL_SEND_REPLY_EMAIL is true
